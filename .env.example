# ==============================================================================
# PARTYKIT CONFIGURATION (BẮT BUỘC)
# ==============================================================================
# Môi trường Local: PartyKit mặc định chạy ở cổng 1999
NEXT_PUBLIC_PARTYKIT_HOST="localhost:1999"

# Môi trường Production (sau khi chạy `npm run deploy:party`):
# NEXT_PUBLIC_PARTYKIT_HOST="your-partykit-project.your-username.partykit.dev"

# ==============================================================================
# CLOUDINARY CONFIGURATION (TÙY CHỌN - LƯU & TỰ ĐỘNG NÉN ẢNH ĐÁM MÂY)
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==============================================================================
# SUPABASE CONFIGURATION (TÙY CHỌN - LƯU METADATA FILE, QUYỀN TRUY CẬP CANVAS)
# ==============================================================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_or_anon_key"
